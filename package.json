{
  "name": "jobhunt-mcp",
  "version": "0.5.0",
  "description": "MCP server exposing a job-application tracker to AI agents, with human-in-the-loop approval on writes",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc -p scripts && tsc -p test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "smoke": "npm run build && tsx scripts/smoke.ts",
    "smoke:http": "npm run build && tsx scripts/smoke-http.ts",
    "smoke:all": "npm run smoke && tsx scripts/smoke-http.ts",
    "show": "tsx scripts/show.ts",
    "demo:db": "npm run db:up && tsx scripts/demo-seed.ts",
    "demo:show": "tsx scripts/show.ts --demo",
    "gmail:connect": "tsx scripts/gmail.ts connect",
    "gmail:status": "tsx scripts/gmail.ts status",
    "gmail:disconnect": "tsx scripts/gmail.ts disconnect",
    "gmail:sync": "tsx scripts/gmail.ts sync",
    "eval": "npm run build && tsx evals/seed.ts && promptfoo eval -c evals/promptfooconfig.yaml -o evals/results/latest.json --no-cache",
    "eval:summary": "node evals/summarize.mjs evals/results/latest.json",
    "eval:view": "promptfoo view"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "ai-agents"
  ],
  "author": "Manmath Kapse",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@google/genai": "^2.30.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "promptfoo": "^0.124.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
