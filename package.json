{
  "name": "jobhunt-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing a job-application tracker to AI agents, with human-in-the-loop approval on writes",
  "main": "dist/index.js",
  "scripts": {
    "dev":"tsx src/index.ts",
    "build":"tsc",
    "start":"node dist/index.js",
    "typecheck":"tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "smoke": "npm run build && tsx scripts/smoke.ts",
    "show": "tsx scripts/show.ts"
  },
  "keywords": ["mcp", "model-context-protocol", "typescript", "ai-agents"],
  "author": "Manmath Kapse",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
