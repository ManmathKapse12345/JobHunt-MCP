# Copy to .env and fill in. .env is gitignored; never commit the real password.
# Supabase dashboard -> Connect -> Session pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# SELECT-only role for read tools, resources and prompts. Create it with
# supabase/migrations/003_mcp_reader.sql, then set its password in the SQL editor:
#   alter role mcp_reader with password '<a long random password>';
# Same host as above; the pooler user name is mcp_reader.<project-ref>.
# If this is missing, reads fall back to DATABASE_URL (with a warning on stderr).
DATABASE_URL_READER=postgresql://mcp_reader.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: port of the local approval page (default 4848).
# APPROVAL_PORT=4848

# ----- Gmail (optional, read-only): see docs/gmail-setup.md -----
# A "Desktop app" OAuth client from Google Cloud.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# Encrypts the saved Google token. Make it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
# Optional: npm run gmail:sync uses Claude to read role and interview/assessment dates
# from tracked emails (only those; never the rest of your inbox). Without it: rules only.
# ANTHROPIC_API_KEY=
# EXTRACT_MODEL=claude-haiku-5-5

# Optional: trace | debug | info (default) | warn | error | fatal | silent.
# Logs are JSON lines on stderr; pipe through `npx pino-pretty` to read them.
# LOG_LEVEL=info

# ----- HTTP mode only (npm run dev:http / dist/http.js / Docker / Render) -----
# Make each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Clients send it as "Authorization: Bearer <token>". At least 32 characters.
# MCP_AUTH_TOKEN=
# The approval page's sign-in password. Never give it to the model. At least 16 characters.
# APPROVAL_ADMIN_TOKEN=
# PORT=3000
# Requests per minute per client IP (/mcp and the approval page; not /healthz). Default 120.
# RATE_LIMIT_PER_MINUTE=120
# Where the server is reached; approval links use it. Defaults to RENDER_EXTERNAL_URL
# (set by Render), else http://localhost:<PORT>.
# PUBLIC_URL=https://jobhunt-mcp.onrender.com
